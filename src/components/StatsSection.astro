---
import profile from "../content/profile.json";
---

<section
  id="stats"
  class="min-h-screen flex flex-col justify-center bg-[var(--color-bg-soft)] px-6 py-24"
>
  <div class="max-w-6xl mx-auto w-full">
    <div class="reveal mb-16 md:mb-24 text-center">
      <p class="text-sm text-[var(--color-ink-muted)] tracking-widest uppercase mb-3">
        Numbers
      </p>
      <h2 class="text-4xl md:text-6xl font-semibold tracking-tight">
        约 5 年时间 <br class="md:hidden" />沉淀的核心成果
      </h2>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 gap-x-6 gap-y-14 md:gap-y-20">
      {
        profile.highlights.map((h, i) => (
          <div class="reveal text-center">
            <p class="text-[11px] md:text-xs text-[var(--color-ink-muted)] font-mono tracking-widest mb-3">
              0{i + 1}
            </p>
            <div class="flex items-baseline justify-center">
              <span
                class="text-[64px] md:text-[96px] font-semibold tracking-tighter leading-none"
                data-countup={h.value}
              >
                0
              </span>
              <span class="text-2xl md:text-4xl font-semibold ml-0.5">
                {h.unit}
              </span>
            </div>
            <p class="mt-4 text-sm md:text-base font-medium tracking-tight">
              {h.label}
            </p>
            {h.sub && (
              <p class="mt-1 text-xs md:text-sm text-[var(--color-ink-muted)]">
                {h.sub}
              </p>
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>
