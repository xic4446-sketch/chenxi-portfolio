---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import cases from "../../content/cases.json";
import { home, imgSrc } from "../../utils/img";

export function getStaticPaths() {
  return cases.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
---

<Layout title={`${item.title}｜陈曦作品集`} description={item.subtitle}>
  <Nav />
  <main class="pt-12">
    <section class="px-6 py-16 md:py-24 bg-[var(--color-bg-soft)]">
      <div class="max-w-6xl mx-auto">
        <a href={`${home}#cases`} class="inline-flex items-center gap-2 text-sm text-[var(--color-ink-muted)] hover:text-[var(--color-ink)] transition-colors">
          <span aria-hidden="true">←</span>
          返回代表项目
        </a>

        <div class="mt-10 grid grid-cols-1 lg:grid-cols-[1.05fr_.95fr] gap-10 lg:gap-16 items-center">
          <div class="reveal">
            <p class="text-sm text-[var(--color-ink-muted)] tracking-widest uppercase mb-4">
              {item.industry} · {item.role}
            </p>
            <h1 class="text-5xl md:text-7xl font-semibold tracking-tight leading-[1.05]">
              {item.title}
            </h1>
            <p class="mt-4 text-2xl md:text-3xl text-[var(--color-ink-muted)] font-light">
              {item.subtitle}
            </p>
            <p class="mt-8 text-base md:text-lg text-[var(--color-ink-muted)] leading-relaxed max-w-2xl">
              {item.background}
            </p>
            <p class="mt-5 px-4 py-3 rounded-xl border border-[var(--color-line)] bg-white text-xs md:text-sm text-[var(--color-ink-muted)] leading-relaxed">
              说明：{item.note}
            </p>
          </div>

          <figure class="reveal rounded-3xl overflow-hidden bg-white shadow-2xl shadow-black/10">
            <img src={imgSrc(item.image)} alt={item.title} class="w-full aspect-[4/5] object-cover object-top" />
          </figure>
        </div>
      </div>
    </section>

    <section class="px-6 py-16 md:py-20 bg-white">
      <div class="max-w-6xl mx-auto">
        <div class={`grid gap-8 border-y border-[var(--color-line)] py-10 ${item.stats.length >= 4 ? "grid-cols-2 md:grid-cols-4" : "grid-cols-3"}`}>
          {item.stats.map((stat) => (
            <div class="reveal text-center">
              <div class="flex items-baseline justify-center">
                <span class="text-3xl md:text-5xl font-semibold tracking-tight">{stat.value}</span>
                <span class="ml-1 text-base md:text-xl font-medium">{stat.unit}</span>
              </div>
              <p class="mt-2 text-xs md:text-sm text-[var(--color-ink-muted)]">{stat.label}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="px-6 py-20 md:py-28 bg-white">
      <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-[.75fr_1.25fr] gap-10 md:gap-20">
        <div class="reveal">
          <p class="text-sm text-[var(--color-ink-muted)] tracking-widest uppercase mb-3">My Contribution</p>
          <h2 class="text-4xl md:text-5xl font-semibold tracking-tight">我具体做了什么</h2>
        </div>
        <ol class="space-y-5">
          {item.contribution.map((text, index) => (
            <li class="reveal flex gap-5 p-5 md:p-6 rounded-2xl bg-[var(--color-bg-soft)]">
              <span class="text-xs font-mono text-blue-600 pt-1">{String(index + 1).padStart(2, "0")}</span>
              <p class="text-base md:text-lg leading-relaxed">{text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="px-6 py-20 md:py-28 bg-black text-white">
      <div class="max-w-6xl mx-auto">
        <div class="reveal max-w-3xl mb-12">
          <p class="text-sm text-white/50 tracking-widest uppercase mb-3">Workflow</p>
          <h2 class="text-4xl md:text-6xl font-semibold tracking-tight">内容工作链路</h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
          {item.process.map((step, index) => (
            <article class="reveal rounded-2xl border border-white/10 bg-white/[.04] p-6 md:p-7">
              <p class="text-xs font-mono text-white/40 mb-8">0{index + 1}</p>
              <h3 class="text-xl md:text-2xl font-semibold">{step.title}</h3>
              <p class="mt-3 text-sm md:text-base text-white/60 leading-relaxed">{step.desc}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="px-6 py-20 md:py-28 bg-[var(--color-bg-soft)]">
      <div class="max-w-6xl mx-auto">
        <div class="reveal mb-12">
          <p class="text-sm text-[var(--color-ink-muted)] tracking-widest uppercase mb-3">Project Evidence</p>
          <h2 class="text-4xl md:text-6xl font-semibold tracking-tight">项目画面</h2>
        </div>
        <div class={`grid grid-cols-1 ${item.gallery.length === 1 ? "max-w-2xl" : "md:grid-cols-2"} gap-6`}>
          {item.gallery.map((visual) => (
            <figure class="reveal bg-white rounded-2xl overflow-hidden border border-[var(--color-line)]">
              <img src={imgSrc(visual.image)} alt={visual.caption} class="w-full max-h-[760px] object-cover object-top" loading="lazy" />
              <figcaption class="p-4 md:p-5 text-sm text-[var(--color-ink-muted)]">{visual.caption}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section class="px-6 py-20 md:py-28 bg-white text-center">
      <div class="max-w-3xl mx-auto reveal">
        <p class="text-sm text-[var(--color-ink-muted)] tracking-widest uppercase mb-3">Next</p>
        <h2 class="text-4xl md:text-5xl font-semibold tracking-tight">想进一步了解项目细节？</h2>
        <a href={`${home}#contact`} class="inline-flex mt-8 px-6 py-3 rounded-full bg-black text-white hover:opacity-80 transition-opacity">
          联系我
        </a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
